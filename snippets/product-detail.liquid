<div class="product-details">
  <h3 class="text-[#000] text-[14px] font-semibold">Product Details</h3>

  <p class="text-[#606060] text-[12px]">
    <span class="text-[#171717] font-semibold">Shade</span><br>
    {{ product.metafields.custom.product_shade }}
  </p>

  <div id="more-details" class="hidden">
    {% if product.metafields.custom.custom_formulation %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">Formulation</span><br>
        {{ product.metafields.custom.custom_formulation }}
      </p>
    {% endif %}

    {% if product.metafields.custom.product_shelf_life %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">Shelf life</span><br>
        {{ product.metafields.custom.product_shelf_life }}
      </p>
    {% endif %}

    {% if product.metafields.custom.product_what_it_is %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">What it is</span><br>
        {{ product.metafields.custom.product_what_it_is }}
      </p>
    {% endif %}

    {% if product.metafields.custom.product_how_to_us %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">How to use</span><br>
        {{ product.metafields.custom.product_how_to_us }}
      </p>
    {% endif %}

    {% if product.metafields.custom.product_shades_available %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">Shades available</span><br>
        {{ product.metafields.custom.product_shades_available }}
      </p>
    {% endif %}

    {% if product.metafields.custom.product_features %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">Features</span><br>
        {{ product.metafields.custom.product_features }}
      </p>
    {% endif %}

    {% if product.metafields.custom.product_about_brand %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">About the brand</span><br>
        {{ product.metafields.custom.product_about_brand }}
      </p>
    {% endif %}

    {% if product.metafields.custom.product_country_of_origin %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">Country of origin :</span>
        {{ product.metafields.custom.product_country_of_origin }}
      </p>
    {% endif %}

    {% if product.metafields.custom.product_return_policy %}
      <p class="text-[#606060] text-[12px]">
        <span class="text-[#171717] font-semibold">Return policy</span><br>
        {{ product.metafields.custom.product_return_policy }}
      </p>
    {% endif %}
  </div>

  {% comment %}
    <button id="toggle-details" class=" text-[#4b6e7e] text-[12px] font-semibold flax">View more details <svg xmlns="http://www.w3.org/2000/svg" width="11" height="6" viewBox="0 0 11 6" fill="none">
    <path d="M9.5 5.25L5.4681 0.980933C5.34972 0.855583 5.15028 0.855583 5.0319 0.980934L1 5.25" stroke="#4B6E7E" stroke-width="1.4" stroke-linecap="round"/>
    </svg></button>
  {% endcomment %}

  <button id="toggle-details" class="flex items-center gap-1 text-[#4B6E7E] font-semibold text-[12px]">
    View more details
    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="6" viewBox="0 0 11 6" fill="none">
      <path d="M9.5 5.25L5.4681 0.980933C5.34972 0.855583 5.15028 0.855583 5.0319 0.980934L1 5.25" stroke="#4B6E7E" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<div id="more-details" class="hidden mt-2">
  <p class="text-gray-600 text-sm">
    View less details
    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="6" viewBox="0 0 11 6" fill="none" class="rotate-180">
      <path d="M9.5 5.25L5.4681 0.980933C5.34972 0.855583 5.15028 0.855583 5.0319 0.980934L1 5.25" stroke="#4B6E7E" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  </p>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggleBtn = document.getElementById('toggle-details');
    const details = document.getElementById('more-details');

    toggleBtn.addEventListener('click', function () {
      if (details.classList.contains('hidden')) {
        details.classList.remove('hidden');
        toggleBtn.innerHTML = `
        View less details
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="6" viewBox="0 0 11 6" fill="none" class="rotate-180">
          <path d="M9.5 5.25L5.4681 0.980933C5.34972 0.855583 5.15028 0.855583 5.0319 0.980934L1 5.25" stroke="#4B6E7E" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      `;
      } else {
        details.classList.add('hidden');
        toggleBtn.innerHTML = `
        View more details
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="6" viewBox="0 0 11 6" fill="none">
          <path d="M9.5 5.25L5.4681 0.980933C5.34972 0.855583 5.15028 0.855583 5.0319 0.980934L1 5.25" stroke="#4B6E7E" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      `;
      }
    });
  });
</script>