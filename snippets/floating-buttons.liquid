<style>
  /* Main button */
  .admin-btn{
    position:relative;
   
    /* border-radius:50px;  */
    border-radius: 10px;
    box-shadow: 0 2px 10px 0 rgba(15, 23, 26, 0.41);
    display:grid; place-items:center; color:#fff;
    background: #EDCC31;
  }
  .admin-actions{
    width:100px !important;
  }
  /* Toggle overlay on top of FAB */
  .admin-toggle{
    appearance:none; -webkit-appearance:none;
    position:absolute; inset:0; margin:0; border:0; outline:none;
    border-radius:9999px; background:transparent; cursor:pointer; z-index:20;
  }

  /* Stack of mini actions */
  .admin-buttons{ position:absolute; bottom:120%; left:0; right: 78%;
    width: 4%; }
  .admin-mini{
    border-radius:10px; display:grid; place-items:center; margin:10px auto 0;
    color:#fff; text-decoration:none; line-height:1.15;
    opacity:0; visibility:hidden; transform:translateY(6px);
    transition:opacity .2s ease, transform .2s ease;
  }
  {% comment %} .admin-mini:hover{ transform:translateY(0) scale(1.05); } {% endcomment %}
  .group:hover .admin-icon {
  transition: transform 0.2s ease-out;
  transform: rotate(90deg);
}

.admin-toggle:checked + .admin-btn .admin-icon {
  transform: rotate(45deg);
  transition: none !important;
}

  .admin-toggle:checked ~ .admin-buttons .admin-mini{ opacity:1; visibility:visible; transform:translateY(0); }
  .admin-buttons .admin-mini:nth-child(1){ transition-delay:.30s; }
  .admin-buttons .admin-mini:nth-child(2){ transition-delay:.25s; }
  .admin-buttons .admin-mini:nth-child(3){ transition-delay:.20s; }
  @media (max-width: 768px) {
    .admin-btn{
      border-radius:50px; 
    }
  }
</style>
