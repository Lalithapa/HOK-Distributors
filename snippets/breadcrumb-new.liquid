<div class=" hidden lg:!block max-w-[160rem] m-auto -translate-x-[20px]">
  <nav class="" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center space-x-2 text-[#B1B1B1]{% if template.name contains "product" %} pt-[40px]{% endif %}">
      <!-- Home -->
      <li class="text-[12px] font-medium text-[#B1B1B1] leading-normal not-italic">
        <a href="{{ routes.root_url }}" class="text-[12px] font-medium text-[#B1B1B1] leading-normal not-italic">Home</a>
      </li>

      {% if template contains 'collection' %}
        <li><span class="text-[#B1B1B1]  text-[12px]">/</span></li>
        
        <li class="text-gray-900 text-[12px]">{{ collection.title }}</li>

      {% elsif template contains 'product' %}
        {% if collection %}
          <li><span class="text-[#B1B1B1]  text-[12px]">/</span></li>
          <li>
            <a href="{{ collection.url }}" class="hover:text-gray-900 text-[12px]">{{ collection.title }}</a>
          </li>
        {% endif %}
        <li><span class="text-gray-400 text-[12px]">/</span></li>
        <li><a href="{{ product.collections.first.title }}" class="text-[#B1B1B1]  text-[12px]"> Collection /</a></li>
        <li class="text-[#626262] text-[12px] font-medium leading-normal not-italic">{{ product.title|truncatewords: 4, '...'}}</li>

      {% elsif template contains 'page' %}
        <li><span class="text-gray-400 text-[12px]">/</span></li>
        <li class="text-gray-900 text-[12px]">{{ page.title }}</li>

      {% elsif template contains 'blog' %}
        <li><span class="text-gray-400 stext-[12px]">/</span></li>
        <li class="text-gray-900 font-medium text-[12px]">{{ blog.title }}</li>

      {% elsif template contains 'article' %}
        <li><span class="text-gray-400 text-[12px]">/</span></li>
        <li>
          <a href="{{ blog.url }}" class="hover:text-gray-900 text-[12px]">{{ blog.title }}</a>
        </li>
        <li><span class="text-gray-400 text-[12px]">/</span></li>
        <li class="text-gray-900 font-medium text-[12px]">{{ article.title }}</li>
      {% endif %}
    </ol>
  </nav>
</div>