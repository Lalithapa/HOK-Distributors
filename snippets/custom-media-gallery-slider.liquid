<div class="sticky top-[6px] product-gallery-product lg:mt-[72px] lg:mb-[72px] lg:max-h-[525px]">
    <!-- Thumbnail Slider -->
    <!-- Up Arrow -->
    <div class="hidden lg:!block">
        <div class="swiper-button-prev thumb-prev"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="6"
                viewBox="0 0 11 6" fill="none">
                <path d="M1 5L5.68 1L10 5" stroke="black" stroke-width="1.2" stroke-linecap="round" />
            </svg></div>
        <div class="swiper thumb-swiper pr-2.5">
            <div class="swiper-wrapper">
                {% for media in product.media %}
                <div class="swiper-slide cursor-pointer" data-media-id="{{ media.id }}"
                    data-swiper-slide-index="{{ forloop.index0 }}">
                    <img src="{{ media | img_url: '200x200' }}" alt="{{ media.alt | escape }}"
                        class="border border-[#F4F4F4]" width="70" height="70" />
                </div>
                {% endfor %}
            </div>
        </div>
        <!-- Down Arrow -->
        <div class="swiper-button-next thumb-next"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="6"
                viewBox="0 0 11 6" fill="none">
                <path d="M1 1L5.68 5L10 1" stroke="black" stroke-width="1.2" stroke-linecap="round" />
            </svg></div>
    </div>
    <!-- Main Slider -->
    <div class="swiper main-swiper">
        <div class="swiper-wrapper">
            {% for media in product.media %}
            <div class="swiper-slide" data-media-id="{{ media.id }}" data-swiper-slide-index="{{ forloop.index0 }}">
                {% case media.media_type %}
                {% when 'image' %}
                <img src="{{ media | image_url}}" alt="{{ media.alt | escape }}" class="w-[460px] h-auto" width="100%" height="100%" />
                {% when 'video' %}
                {{ media | video_tag: controls: true, autoplay: false, class: "w-full h-auto" }}
                {% when 'external_video' %}
                {{ media | external_video_tag }}
                {% when 'model' %}
                {{ media | model_viewer_tag }}
                {% endcase %}
            </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination md:hidden"></div>
    </div>
</div>
<script>
    // Thumbnail Swiper
    var thumbSwiper = new Swiper(".thumb-swiper", {
        direction: 'vertical',
        slidesPerView: 5,
        spaceBetween: 1,
        watchSlidesProgress: true,
        navigation: {
            nextEl: ".thumb-next", // bottom arrow
            prevEl: ".thumb-prev", // top arrow
        },
    });
    // Main Swiper
    var mainSwiper = new Swiper(".main-swiper", {
        spaceBetween: 10,
        thumbs: {
            swiper: thumbSwiper,
        },
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
    });

</script>

<style>
    .product-gallery-product {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        /* position: relative; */
    }

    .product-gallery-product .swiper-horizontal>.swiper-pagination-bullets,
    .swiper-pagination-bullets.swiper-pagination-horizontal {
        left: 35%;
    }

    .product-gallery-product .thumb-swiper {

        width: 80px;
        height: 500px;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .product-gallery-product .swiper-button-prev {
        top: -3%;
        left: 2%;
        height: 27px !important;
        width: 50px;
        border-radius: 17px;
        border: 1px solid #CDCDCD;
    }

    .product-gallery-product .swiper-button-next {
        right: 0;
        left: 3%;
        top: unset;
        bottom: -4%;
        height: 27px !important;
        width: 50px;
        border-radius: 17px;
        border: 1px solid #CDCDCD;
    }

    .product-gallery-product .swiper-button-prev:after,
    .swiper-button-next:after {
        display: none;
    }

    .product-gallery-product .swiper-pagination-bullet-active {
        background: #1E1E1E
    }

    .product-gallery-product .thumb-swiper img {
        width: 100%;
        height: auto;
        cursor: pointer;
    }

    .swiper-slide.cursor-pointer.swiper-slide-visible.swiper-slide-active.swiper-slide-thumb-active img {
        border: 1px solid #848484;
        border-radius: 10px;
    }

    .product-gallery-product .thumb-swiper .swiper-button-prev,
    .product-gallery-product .thumb-swiper .swiper-button-next {
        width: 28px;
        height: 28px;
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .product-gallery-product .thumb-swiper .swiper-button-prev:after,
    .product-gallery-product .thumb-swiper .swiper-button-next:after {
        font-size: 14px;
        color: #000;
    }

    .product-gallery-product .thumb-swiper .swiper-button-prev {
        order: -1;
        /* top arrow */
        margin-bottom: 10px;
    }

    .product-gallery-product .thumb-swiper .swiper-button-next {
        margin-top: 10px;
    }

    .product-gallery-product .main-swiper {
        flex: 1;
    }
</style>