{% assign vendor_name = product.vendor %}
{% case vendor_name %}
{% when "Revolution Beauty" %}
<div class="flex items-center justify-between border-b border-t  border-gray-200 pt-[4px] pr-[19px] pb-[4px] pl-[5px] !my-[24px]">
  <div class="flex items-center gap-[10px]">
    <!-- Logo -->
    <img
      src="{{ product.metafields.custom.brand_logo| image_url: width: 48 }}"
      alt="{{ block.settings.brand_title }}"
      width="35"
      height="35"
      class="w-[35px] h-[35px] rounded-full object-contain border"
    >
    <div>
      <h3 class="!text-[12px]  text-[#212121] tracking-[-0.24px] lg:font-medium font-normal lg:uppercase">
        {% comment %} {{ product.metafields.custom.brand_title.value }} {% endcomment %}
          {{'makeup revolution'}}
      </h3>
      <p class="text-[11px] lg:text-[#9C9C9C] text-[#36881B] tracking-[-0.55px]">
        {{ 'Explore all products' }}
      </p>
    </div>
  </div>
  {% if product.collections.size > 0 %}
    <a href="#" class="share-link">
      {% render 'share-icon', icon: 'brand-icon' %}
    </a>
  {% endif %}
</div>
{% when "L.A. Girl" %}
<div class="flex items-center justify-between border-b  border-t  border-gray-200 pt-[4px] pr-[19px] pb-[4px] pl-[5px] !my-[24px]">
  <div class="flex items-center gap-[10px]">
    <!-- Logo -->
    <img
      src="{{ product.metafields.custom.brand_logo| image_url: width: 48 }}"
      alt="{{ block.settings.brand_title }}"
      width="35"
      height="35"
      class="w-18 h-18 rounded-full object-contain border"
    >
    <div>
      <h3 class="!text-[12px]  text-[#212121] tracking-[-0.24px] lg:font-medium font-normal lg:uppercase">
        {% comment %} {{ product.metafields.custom.brand_title.value }} {% endcomment %}
          {{'L.A. Girl'}}
      </h3>
      <p class="text-[11px] lg:text-[#9C9C9C] text-[#36881B]  tracking-[-0.55px]">
        {{ 'Explore all products' }}
      </p>
    </div>
  </div>
  {% if product.collections.size > 0 %}
    <a href="#" class="share-link">
      {% render 'share-icon', icon: 'brand-icon' %}
    </a>
  {% endif %}
</div>
{% endcase %}