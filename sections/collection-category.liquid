{%- style -%}
    .section-{{ section.id }}-margin  {
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }

    @media screen and (max-width: 768px) {
      .section-{{ section.id }}-margin  {
        margin-top: {{ section.settings.margin_top_mobile }}px;
        margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      }
    }
{%- endstyle -%}
<section class="page-width section-{{ section.id }}-margin">
  <div class="mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-center gap-4">
      <div>
        {% if section.settings.title != blank %}
          <h2 class="text-[14px] lg:text-2xl font-semibold text-gray-900">
            {{ section.settings.title }}
          </h2>
        {% endif %}
        {% if section.settings.subtext != blank %}
          <p class="mt-1 text-[11px] lg:text-[14px] text-[#2F2F2F]">
            {{ section.settings.subtext }}
          </p>
        {% endif %}
      </div>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}"
           class="shrink-0 inline-flex items-center lg:rounded-full lg:bg-yellow-400 lg:hover:bg-yellow-500 text-[#222529] lg:text-[#3F3F3F] font-semibold text-[12px] lg:text-[14px] lg:px-[20px] lg:py-[8px] shadow-sm transition">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    <!-- Cards -->
    <ul class="mt-6 !grid auto-cols-[28.5%] grid-flow-col lg:grid-flow-row lg:grid-cols-6 gap-[8px] lg:gap-5 overflow-x-auto snap-x snap-mandatory [&>*]:snap-start custom-scrollbar">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          {% assign item_alt = block.settings.alt | default: block.settings.title | default: section.settings.title %}
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="block group">{% endif %}
            <div class="rounded-xl bg-white shadow-sm overflow-hidden transition group-hover:shadow-md group-hover:-translate-y-0.5">
              <div class="grid place-items-center bg-[#F9F9F9] !mb-1"> 
                {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url }}" alt="{{ item_alt | escape }}" class="object-contain mix-blend-multiply transition-transform duration-300 ease-in-out hover:scale-105" loading="lazy" width="100%" height="100%">
                {% else %}
                  <div class="text-xs text-gray-400">Upload image</div>
                {% endif %}
              </div>
              <div class="px-3 pb-3 text-center">
                {% if block.settings.title != blank %}
                  <span class="block text-[14px] font-semibold text-[#242527]">
                    {{ block.settings.title }}
                  </span>
                {% endif %}
              </div>
            </div>
          {% if block.settings.link != blank %}</a>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection Category",
  "settings": [
     {
    "type": "header",
    "content": "Desktop Margin"
    },
  {
    "type": "range",
    "id": "margin_top_desktop",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Top",
    "default": 36
  },

  {
    "type": "range",
    "id": "margin_bottom_desktop",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Bottom",
    "default": 36
  },
   {
    "type": "header",
    "content": "Mobile Margin"
  },
  {
    "type": "range",
    "id": "margin_top_mobile",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Top",
    "default": 36
  },
  {
    "type": "range",
    "id": "margin_bottom_mobile",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Bottom",
    "default": 36
  },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Face"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subheading",
      "default": "Foundations, powders & more that sell fast"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "Bronzer"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Collection Category",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
