  <script>
    const HIDE = ['opacity-0','hidden','invisible','pointer-events-none'];
    const show = el => el && el.classList.remove(...HIDE);
    const hide = el => el && el.classList.add(...HIDE);

    function openModal(id) {
      show(document.getElementById(id));
      show(document.getElementById('model-overlay'));
      document.body.classList.add('overflow-hidden');
    }

    function closeModal(id = 'all') {
      if (id === 'all') {
        document.querySelectorAll('.modal-path').forEach(hide);
      } else {
        hide(document.getElementById(id));
      }
      hide(document.getElementById('model-overlay'));
      document.body.classList.remove('overflow-hidden');
    }

    // Close all on ESC
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeModal('all');
    });
    document.addEventListener("DOMContentLoaded", function () {
        // Check if current page is cart page
        if (window.location.href === "https://www.hokdistributors.com/cart") {
          // Find all link[rel="stylesheet"] elements
          document.querySelectorAll('link[rel="stylesheet"]').forEach(link => {
            if (link.href.includes("netterm.css")) {
              link.remove();
              console.log("Removed netterm.css from cart page");
            }
          });
        }
      });
  </script>

