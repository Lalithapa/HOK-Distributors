{% comment %}
Cart (left) + Last order (right)
- No blocks. Uses Liquid objects: cart, customer, customer.orders
- Reorder button builds /cart/VARIANT:QTY,... permalink
{% endcomment %}
{% if cart.item_count > 0 or customer.orders_count > 0 %}
<section class="w-full px-[20px] scroll-trigger animate--fade-in">
    <div class="mx-auto rounded-2xl border border-gray-200 bg-[#FBFBF8] ">
        <div class="page-width">
            <div class="py-[30px] lg:grid lg:grid-cols-2">
                {%- comment -%} LEFT: Cart items / Abandoned cart {%- endcomment -%}
                {% if cart != blank and cart.item_count > 0 %}
                <div class="pr-0 lg:pr-6">
                    <div class="flex items-start justify-between border-b border-[#ECECEC] pb-2 mb-8">
                        <div>
                            <h3 class="text-[16px] font-semibold text-[#2A2F38]">You have these in your cart</h3>
                            <p class="text-[14px] text-[#959595]">Confirm now to save more</p>
                        </div>
                        <button type="button"
                            class="ml-3 inline-flex h-7 w-7 items-center justify-center rounded-full hover:bg-gray-100 text-gray-500">
                            <svg xmlns="http://www.w3.org/2000/svg" width="12" height="13" viewBox="0 0 12 13"
                                fill="none">
                                <path d="M1 11.5L11 1.5" stroke="black" stroke-width="2" stroke-linecap="round" />
                                <path d="M11 11.5L0.999999 1.5" stroke="black" stroke-width="2"
                                    stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>
                    <ul class="mt-4 flex items-start gap-4 overflow-x-auto pb-1">
                        {% for item in cart.items limit:4 %}
                        <li class="shrink-0">
                            <a href="{{ item.url }}" class="block">
                                <div
                                    class="w-[98px] h-[98px] rounded-2xl border border-[#DCDCDC] bg-white grid place-items-center shadow-sm !mb-1">
                                    {% if item.image %}
                                    <img src="{{ item.image | image_url }}" alt="{{ item.product.title | escape }}"
                                        class="object-contain mix-blend-multiply" loading="lazy" width="98" height="98">
                                    {% else %}
                                    <span class="text-[10px] text-gray-400">No image</span>
                                    {% endif %}
                                </div>
                                <p
                                    class="mt-1 text-center text-[11px] text-gray-700 truncate w-[90px] mx-auto overflow-x-hidden">
                                    {{ item.product.title | capitalize | truncate: 15 }}
                                </p>
                            </a>
                        </li>
                        {% endfor %}
                        {% if cart.items.size > 4 %}
                        <li class="shrink-0">
                            <a href="{{ routes.cart_url }}" class="block">
                                <div
                                    class="w-[98px] h-[98px] rounded-2xl border border-[#DCDCDC] bg-white grid place-items-center shadow-sm !mb-1">
                                    <img src="https://cdn.shopify.com/s/files/1/0719/3119/9705/files/addition.png"
                                        alt="{{ " See all" }}" class="object-contain mix-blend-multiply" loading="lazy"
                                        width="98" height="98">
                                </div>
                                <p
                                    class="mt-1 text-center text-[11px] text-[#4B6E7E] w-[90px] font-semibold mx-auto overflow-x-hidden">
                                    {{ "See all" }}
                                </p>
                            </a>
                        </li>
                        {% endif %}
                    </ul>

                    <div class="mt-[16px]">
                        <a href="{{ routes.cart_url }}"
                            class="inline-flex max-w-[250px] items-center justify-center rounded-full bg-yellow-400 hover:bg-yellow-500 text-[#080808] font-medium text-[14px] px-12 py-2.5 transition shadow-sm">
                            Complete your order
                        </a>
                    </div>
                </div>
                {% endif %}
                {%- comment -%} RIGHT: Last order summary {%- endcomment -%}

                {% if customer and customer.orders_count > 0 %}
                <div class="pt-6 lg:pt-0 lg:pl-6">
                    <div class="flex items-start justify-between border-b border-[#ECECEC]  pb-2 mb-8">
                        <div>
                            <h3 class="text-[16px] font-semibold text-[#2A2F38]">Your last order</h3>
                            {% if customer.orders_count > 0 %}
                            {% assign last_order = customer.orders.first %}
                            {% assign status = last_order.fulfillment_status | default: '—' %}
                            <p class="mt-1 text-[14px] text-[#959595]">
                                <span class="text-gray-600">Status :</span>
                                <span
                                    class="{% if status == 'fulfilled' %}text-green-600{% elsif status == 'partial' %}text-amber-600{% else %}text-gray-700{% endif %}">
                                    {{ status | capitalize }}
                                </span>
                            </p>
                            {% endif %}
                        </div>
                        <button type="button"
                            class="ml-3 inline-flex h-7 w-7 items-center justify-center rounded-full hover:bg-gray-100 text-gray-500">
                            <svg xmlns="http://www.w3.org/2000/svg" width="12" height="13" viewBox="0 0 12 13"
                                fill="none">
                                <path d="M1 11.5L11 1.5" stroke="black" stroke-width="2" stroke-linecap="round" />
                                <path d="M11 11.5L0.999999 1.5" stroke="black" stroke-width="2"
                                    stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>


                    {% assign last_order = customer.orders.first %}
                    {% assign first_item = last_order.line_items.first %}

                    <div class="mt-4 flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
                        <div
                            class="w-[98px] h-[98px] rounded-2xl border border-[#DCDCDC] bg-white grid place-items-center shadow-sm !mb-1 overflow-hidden">
                            {% if first_item and first_item.image %}
                            <img src="{{ first_item.image | image_url }}" alt="{{ first_item.title | escape }}"
                                class="object-contain mix-blend-multiply" loading="lazy" loading="lazy" width="98"
                                height="98">
                            {% endif %}
                        </div>

                        <div class="flex-1">
                            <p class="text-[14px] font-semibold text-[#222D32]">
                                {{ first_item.product.vendor | default: first_item.vendor }}
                            </p>
                            <p class="text-[13px] text-[#797A7E] line-clamp-2 leading-normal">
                                {{ first_item.title }}
                            </p>
                            <div class="mt-1 flex items-center gap-6 text-[12px] text-[#3D3A3A] justify-between">
                                <span class="text-[#797A7E] font-bold">
                                    {{ first_item.final_price | money_without_trailing_zeros }} × {{ first_item.quantity
                                    }}
                                </span>
                                <span class="font-medium">
                                    Total :{{ last_order.total_price | money }}
                                </span>
                            </div>
                        </div>
                    </div>

                    {%- comment -%} Build reorder permalink: /cart/VARIANT:QTY,VARIANT2:QTY2 {%- endcomment -%}
                    {% capture variant_qty_list %}
                    {% for li in last_order.line_items %}
                    {% if li.variant_id %}{{ li.variant_id }}:{{ li.quantity }}{% if forloop.last == false %},{% endif
                    %}{% endif %}
                    {% endfor %}
                    {% endcapture %}
                    {% assign reorder_link = '/cart/' | append: variant_qty_list | replace: ' ', '' %}

                    <div class="mt-4 flex flex-col sm:flex-row gap-3">
                        <a href="{{ last_order.customer_url }}"
                            class="inline-flex max-w-[250px] items-center justify-center rounded-full border border-gray-300 bg-white hover:bg-gray-50 text-gray-800 font-semibold text-[14px] px-12 py-2.5 transition shadow-sm">
                            View order
                        </a>
                        <a href="{{ reorder_link }}"
                            class="inline-flex max-w-[250px] items-center justify-center rounded-full bg-yellow-400 hover:bg-yellow-500 text-[#080808] font-medium text-[14px] px-12 py-2.5 transition shadow-sm">
                            Reorder
                        </a>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endif %}
{% schema %}
{
"name": "Cart and Last order",
"settings": [],
"presets": [
{ "name": "Cart and Last order" }
]
}
{% endschema %}