<section
  id="distributor-hero-{{ section.id }}"
  class="w-full bg-white"
  style="padding-top: {{ section.settings.pt }}px; padding-bottom: {{ section.settings.pb }}px;">
  <div class="w-[98%] mx-auto px-4">
    <div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="w-full lg:!w-[70%]">
        {%- if section.settings.desktop_image != blank or section.settings.mobile_image != blank -%}
          <picture class="block ">
            {%- if section.settings.desktop_image != blank -%}
              <source
                media="(min-width: 768px)"
                srcset="{{ section.settings.desktop_image | image_url: width: 1600 }}"
              >
            {%- endif -%}
            <img
              class="w-full h-auto rounded-2xl shadow"
              src="{{ section.settings.mobile_image | default: section.settings.desktop_image | image_url: width: 1000 }}"
              alt="{{ section.settings.alt | escape }}"
              loading="lazy"
              width="100%"
              height="auto"
            >
          </picture>
        {%- else -%}
          <div class="aspect-[16/9] bg-gray-100 rounded-2xl"></div>
        {%- endif -%}
      </div>
      <div class="w-full lg:w-[25%] mt-[40px] lg:mt-[0px]">
        {%- if section.settings.show_pills and section.blocks.size > 0 -%}
          <div class="flex flex-col gap-[20px] lg:gap-[42px] mb-6 lg:mb-8">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pill' -%}
                <div class="inline-flex justify-center items-center">
                  <span
                    class="text-[14px] md:text-[14px] font-medium lg:font-semibold tracking-tight rounded-[4px] px-[10px] py-[3px] bg-[#CDEBF9] text-[#4B6E7E] w-[240px] text-center"
                  >
                    {{ block.settings.text }}
                  </span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.location_text != blank -%}
      <div class="mt-4  items-center gap-[12px] text-sm lg:text-base text-[#0F172A] lg:!hidden flex justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="22" viewBox="0 0 18 24" fill="none">
          <path
              d="M9 2.89346C7.14348 2.89346 5.36301 3.63095 4.05025 4.94371C2.7375 6.25646 2 8.03694 2 9.89346C2 12.7555 3.782 15.5165 5.738 17.6555C6.73814 18.7451 7.82943 19.7474 9 20.6515C9.17467 20.5175 9.37967 20.3541 9.615 20.1615C10.5548 19.3897 11.4393 18.553 12.262 17.6575C14.218 15.5165 16 12.7565 16 9.89346C16 8.03694 15.2625 6.25646 13.9497 4.94371C12.637 3.63095 10.8565 2.89346 9 2.89346ZM9 23.1075L8.433 22.7175L8.43 22.7155L8.424 22.7105L8.404 22.6965L8.329 22.6435L8.059 22.4465C6.69086 21.4182 5.41988 20.2668 4.262 19.0065C2.218 16.7685 0 13.5295 0 9.89246C3.55683e-08 7.50551 0.948211 5.21632 2.63604 3.5285C4.32387 1.84067 6.61305 0.892456 9 0.892456C11.3869 0.892456 13.6761 1.84067 15.364 3.5285C17.0518 5.21632 18 7.50551 18 9.89246C18 13.5295 15.782 16.7695 13.738 19.0045C12.5804 20.2647 11.3098 21.4162 9.942 22.4445C9.82805 22.5296 9.71305 22.6132 9.597 22.6955L9.576 22.7095L9.57 22.7145L9.568 22.7155L9 23.1075ZM9 7.89346C8.46957 7.89346 7.96086 8.10417 7.58579 8.47924C7.21071 8.85432 7 9.36302 7 9.89346C7 10.4239 7.21071 10.9326 7.58579 11.3077C7.96086 11.6827 8.46957 11.8935 9 11.8935C9.53043 11.8935 10.0391 11.6827 10.4142 11.3077C10.7893 10.9326 11 10.4239 11 9.89346C11 9.36302 10.7893 8.85432 10.4142 8.47924C10.0391 8.10417 9.53043 7.89346 9 7.89346ZM5 9.89346C5 8.83259 5.42143 7.81517 6.17157 7.06503C6.92172 6.31488 7.93913 5.89346 9 5.89346C10.0609 5.89346 11.0783 6.31488 11.8284 7.06503C12.5786 7.81517 13 8.83259 13 9.89346C13 10.9543 12.5786 11.9717 11.8284 12.7219C11.0783 13.472 10.0609 13.8935 9 13.8935C7.93913 13.8935 6.92172 13.472 6.17157 12.7219C5.42143 11.9717 5 10.9543 5 9.89346Z"
              fill="#4C6D7D" />
        </svg>
        <span class="text-[#28586D] text-center text-[14px] not-italic font-medium leading-normal">
          {{- section.settings.location_text -}}
        </span>
      </div>
    {%- endif -%}
    <div class="max-w-[93%] flex flex-col  lg:flex-row mt-[60px] gap-[1px] mx-auto ">
      <div class=" w-full  lg:w-[60%]">
        {%- if section.settings.heading != blank -%}
          <h2
            class="mb-[24px] lg:mb-0 !text-[28px] lg:!text-[54px] xl:text-[56px] !text-[#2A2F38]  not-italic font-medium leading-[72px] tracking-[-2.8px]"
          >
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.location_text != blank -%}
          <div class="mt-4  items-center gap-[12px] text-sm lg:text-base text-[#0F172A]/70 lg:!flex hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="24" viewBox="0 0 18 24" fill="none">
              <path
                  d="M9 2.89346C7.14348 2.89346 5.36301 3.63095 4.05025 4.94371C2.7375 6.25646 2 8.03694 2 9.89346C2 12.7555 3.782 15.5165 5.738 17.6555C6.73814 18.7451 7.82943 19.7474 9 20.6515C9.17467 20.5175 9.37967 20.3541 9.615 20.1615C10.5548 19.3897 11.4393 18.553 12.262 17.6575C14.218 15.5165 16 12.7565 16 9.89346C16 8.03694 15.2625 6.25646 13.9497 4.94371C12.637 3.63095 10.8565 2.89346 9 2.89346ZM9 23.1075L8.433 22.7175L8.43 22.7155L8.424 22.7105L8.404 22.6965L8.329 22.6435L8.059 22.4465C6.69086 21.4182 5.41988 20.2668 4.262 19.0065C2.218 16.7685 0 13.5295 0 9.89246C3.55683e-08 7.50551 0.948211 5.21632 2.63604 3.5285C4.32387 1.84067 6.61305 0.892456 9 0.892456C11.3869 0.892456 13.6761 1.84067 15.364 3.5285C17.0518 5.21632 18 7.50551 18 9.89246C18 13.5295 15.782 16.7695 13.738 19.0045C12.5804 20.2647 11.3098 21.4162 9.942 22.4445C9.82805 22.5296 9.71305 22.6132 9.597 22.6955L9.576 22.7095L9.57 22.7145L9.568 22.7155L9 23.1075ZM9 7.89346C8.46957 7.89346 7.96086 8.10417 7.58579 8.47924C7.21071 8.85432 7 9.36302 7 9.89346C7 10.4239 7.21071 10.9326 7.58579 11.3077C7.96086 11.6827 8.46957 11.8935 9 11.8935C9.53043 11.8935 10.0391 11.6827 10.4142 11.3077C10.7893 10.9326 11 10.4239 11 9.89346C11 9.36302 10.7893 8.85432 10.4142 8.47924C10.0391 8.10417 9.53043 7.89346 9 7.89346ZM5 9.89346C5 8.83259 5.42143 7.81517 6.17157 7.06503C6.92172 6.31488 7.93913 5.89346 9 5.89346C10.0609 5.89346 11.0783 6.31488 11.8284 7.06503C12.5786 7.81517 13 8.83259 13 9.89346C13 10.9543 12.5786 11.9717 11.8284 12.7219C11.0783 13.472 10.0609 13.8935 9 13.8935C7.93913 13.8935 6.92172 13.472 6.17157 12.7219C5.42143 11.9717 5 10.9543 5 9.89346Z"
                  fill="#4C6D7D" />
            </svg>
            <span
              class="text-[#6C8D9C] text-center text-[20px] not-italic font-normal leading-normal tracking-[-1px]"
            >
              {{- section.settings.location_text -}}
            </span>
          </div>
        {%- endif -%}
      </div>
      {%- if section.settings.body != blank -%}
        <div
          class="w-full lg:w-[60%] prose !text-[#797878] text-[16px] lg:text-[22px] not-italic font-medium leading-normal tracking-[-1.1px]"
        >
          {{ section.settings.body }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Us Top",
  "class": "section-distributor-hero",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable section", "default": true },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image (≥768px)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (<768px)" },
    { "type": "text", "id": "alt", "label": "Image alt text", "default": "Beauty distributor hero image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your trusted beauty distributor partner" },
    { "type": "text", "id": "location_text", "label": "Location text", "default": "Headquartered in Delhi" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>From our roots in 2012 introducing Fini to India, to building HOK Makeup into a category leader, Kanvar Group has led premium beauty brand distribution. Our journey includes strategic launches of L.A. Girl, Milani, Revolution Beauty, and many more across India and Bangladesh.</p>"
    },
    { "type": "checkbox", "id": "show_pills", "label": "Show highlight pills", "default": true },
    { "type": "range", "id": "pt", "label": "Padding top (px)", "min": 0, "max": 160, "step": 4, "default": 40 },
    { "type": "range", "id": "pb", "label": "Padding bottom (px)", "min": 0, "max": 160, "step": 4, "default": 40 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "limit": 8,
      "settings": [
        { "type": "html", "id": "text", "label": "Text", "default": "<p>#1 distributor of global brands</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Hero",
      "category": "Hero",
      "blocks": [
        { "type": "pill", "settings": { "text": "#1 distributor of global brands" } },
        { "type": "pill", "settings": { "text": "100% authentic distributors" } },
        { "type": "pill", "settings": { "text": "Trusted by 200+ clients" } },
        { "type": "pill", "settings": { "text": "Endless Beauty Choices" } },
        { "type": "pill", "settings": { "text": "Powered by Experience" } }
      ]
    }
  ]
}
{% endschema %}