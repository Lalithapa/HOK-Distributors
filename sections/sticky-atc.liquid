{% if section.settings.enable_section and request.page_type == 'product' and product.available %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    assign product_form_id = 'product-form-' | append: section.id
    assign image = current_variant.image | default: product.featured_image
    assign img_size = section.settings.img_width | append: 'x' | append: section.settings.img_height
  %}

  <style>
    #md-sticky-atc {
      padding-top: {{ section.settings.pt }}rem;
      padding-bottom: {{ section.settings.pb }}rem;
      visibility: hidden;
      opacity: 0;
      transform: translateY(100%);
      transition: all .15s ease-out;
      border-top: 0.1rem solid rgba(var(--color-foreground), .08);
    }
    #md-sticky-atc.show {
      visibility: visible;
      opacity: 1;
      z-index: 999;
      transform: translateY(0);
    }
    {% comment %} .sticky_btn_qnty{
    display:none;
  } {% endcomment %}

    @media (max-width: 768px) {
      .button { padding: 0 12px; font-size: 15px !important; min-width: unset !important; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const stickyATC = document.querySelector('#md-sticky-atc');
      if (!stickyATC) return;

      const img = stickyATC.querySelector('.product-content img');
      const selectField = stickyATC.querySelector('select[name="id"]');
      const triggerPercent = 0.1;
      const minPixelsFallback = 80;

      const getScrollable = () =>
        Math.max(document.documentElement.scrollHeight, document.body.scrollHeight) - window.innerHeight;

      const shouldShow = () => {
        const total = getScrollable();
        if (total <= 0) {
          return window.scrollY >= minPixelsFallback;
        }
        const progress = window.scrollY / total; // 0 → 1
        return progress >= triggerPercent;
      };

      const handleScroll = () => {
        if (shouldShow()) {
          stickyATC.classList.add('show');
          document.documentElement.style.paddingBottom = `${stickyATC.clientHeight}px`;
        } else {
          stickyATC.classList.remove('show');
          document.documentElement.style.paddingBottom = '0';
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('resize', handleScroll, { passive: true });
      handleScroll();
      if (selectField && img) {
        selectField.addEventListener('change', () => {
          const opt = selectField.options[selectField.selectedIndex];
          if (opt?.dataset?.img) img.src = opt.dataset.img;
        });
      }
      const mainVariantSelect = document.querySelector('.product-form-custom [name="id"]');
      if (mainVariantSelect && selectField) {
        mainVariantSelect.addEventListener('change', (e) => {
          if (e.target.value) selectField.value = e.target.value;
        });
      }
      document.querySelectorAll('.sticky-atc-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          btn.classList.add('hidden');
          const qntyBlock = btn.parentElement?.querySelector('.sticky_btn_qnty');
          if (qntyBlock) qntyBlock.classList.remove('hidden');
        });
      });
    });
  </script>

  <div
    id="md-sticky-atc"
    class="color-{{ section.settings.color_scheme }} md:hidden fixed bottom-0 left-0 w-full "
    aria-hidden="true"
    data-offset="{{ section.settings.offset }}"
  >
    <div class="page-width-inner">
      <div class="product-content flex items-center">
        {% if section.settings.show_img %}
          <img
            src="{{ image | img_url: img_size, crop: 'center' }}"
            alt="{{ product.title | escape }}"
            width="{{ section.settings.img_width }}"
            height="{{ section.settings.img_height }}"
            loading="lazy"
            class="mr-[12px]"
          >
        {% endif %}

        <div>
          {% if section.settings.show_title %}
            <h3 class="product__title {{ section.settings.title_size }}">{{ product.title }}</h3>
          {% endif %}

          {% if section.settings.show_price %}
            <div class="no-js-hidden" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
              {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: '' -%}
            </div>
          {% endif %}
        </div>
      </div>
      <div class="flex justify-center gap-[6px]">
        <a
          href="tel:+918130267067"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-[#D9D9D9] bg-white px-[16px] py-[10px] text-[14px] font-bold uppercase tracking-wide text-[#212121] shadow-sm hover:shadow transition"
        >
          <img
            src="https://cdn.shopify.com/s/files/1/0719/3119/9705/files/call_2.png?v=1756879743"
            alt="Call icon"
            class="w-[14px] h-[14px] object-contain"
            width="14"
            height="14"
          >
          <span class="whitespace-nowrap">Call to Order</span>
        </a>
        {%- assign v = product.selected_or_first_available_variant -%}
        {%- assign in_cart = 0 -%}
        {%- if cart and cart.item_count > 0 -%}
          {%- for item in cart.items -%}
            {%- if item.variant_id == v.id -%}
              {%- assign in_cart = item.quantity -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {% comment %} <button
          type="button"
          class="sticky-atc-btn inline-flex items-center justify-center whitespace-nowrap rounded-full bg-[#EDCC31] py-[12px] px-[44px] lg:px-[70px] text-[14px] font-bold uppercase tracking-wide text-[#262933] cursor-pointer"
        >
          Add to Cart
        </button> {% endcomment %}

        {%- if in_cart == 0 -%}
  <button
    type="button"
    class="sticky-atc-btn inline-flex items-center justify-center whitespace-nowrap rounded-full bg-[#EDCC31] py-[12px] px-[44px] lg:px-[70px] text-[14px] font-bold uppercase tracking-wide text-[#262933] cursor-pointer"
  >
    Add to Cart
  </button>
{%- endif -%}

        <product-form class="{%- if in_cart == 0 -%}hidden {% else %}block{% endif %} product-form-custom sticky_btn_qnty">
          {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate' -%}
            <div class="quantity-input-wrapper flex  justify-center  items-stretch w-full gap-0">
              <div
                class="select md:max-w-[50%] max-w-[40%]  flex-initial mr-3 "
                style="{% if product.has_only_default_variant %}display: none;{% endif %}"
              >
                <select class="select__select !pr-0" name="id" aria-label="Select variant">
                  {% for variant in product.variants %}
                    {% assign variant_image = variant.image | default: product.featured_image %}
                    <option
                      value="{{ variant.id }}"
                      data-img="{{ variant_image | img_url: img_size }}"
                      {% if current_variant.id == variant.id %}
                        selected
                      {% endif %}
                    >
                      {{ variant.title }} - {{ variant.price | money }}
                    </option>
                  {% endfor %}
                </select>
                <svg
                  aria-hidden="true"
                  focusable="false"
                  role="presentation"
                  class="icon icon-caret w-[12px] inline-block align-middle mr-[15px]"
                  viewBox="0 0 10 6"
                >
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path>
                </svg>
              </div>
              {% comment %} changes by me {% endcomment %}
              {%- assign v = product.selected_or_first_available_variant -%}
              {%- assign min_q = v.quantity_rule.min | default: 1 -%}
              {%- assign max_q = v.quantity_rule.max -%}
              {% comment %} {%- assign step_q = v.quantity_rule.increment | default: 1 -%} {% endcomment %}

              {%- assign in_cart = 0 -%}
              {%- if cart and cart.item_count > 0 -%}
                {%- for item in cart.items -%}
                  {%- if item.variant_id == v.id -%}
                    {%- assign in_cart = item.quantity -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- assign value_q = in_cart | default: 0 -%}
              {%- if value_q == 0 -%}{%- assign value_q = min_q -%}{%- endif -%}
              {%- if max_q and value_q > max_q -%}{%- assign value_q = max_q -%}{%- endif -%}
              {%- if value_q < min_q -%}{%- assign value_q = min_q -%}{%- endif -%}
              {% comment %} changes by me {% endcomment %}

              {% if section.settings.show_quantity_input %}
                <quantity-input class="quantity flex-[0_0_30%] max-w-[120px] !w-[20%] after:hidden before:hidden !rounded-tl-[100px] !rounded-bl-[100px] !rounded-tr-none !rounded-br-none border-l border-b border-t border-[#D9D9D9]">
                  <button class="quantity__button no-js-hidden flex-1" name="minus" type="button">
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                    </span>
                    <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                  </button>

                  <input
                    class="quantity__input flex-1"
                    type="number"
                    name="quantity"
                    id="Quantity-{{ section.id }}"
                    min="{{ value_q }}"
                    value="{{ value_q }}"
                    form="{{ product_form_id }}"
                  >

                  <button class="quantity__button no-js-hidden flex-1" name="plus" type="button">
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                    </span>
                    <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                  </button>
                </quantity-input>
              {% endif %}

              <button
                type="submit"
                name="add"
                class="product-form__submit button button--{{ section.settings.btn_style }} shrink-0 grow !m-0 !bg-[#edcc31] !text-[#262933] !border-0 flex-1 after:hidden before:hidden !rounded-[0px_26px_26px_0px] rounded-tr-[26px] rounded-br-[26px]"
              >
                <span class="font-bold uppercase tracking-wide text-[#262933]">
                  {%- if current_variant.available -%}
                    Proceed to Cart
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                <div class="loading__spinner hidden">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                    class="spinner"
                    viewBox="0 0 66 66"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30" style="stroke: rgb(var(--color-background));"></circle>
                  </svg>
                </div>
              </button>
            </div>
          {% endform %}
        </product-form>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Sticky ATC",
  "settings": [
    { "type": "header", "content": "General" },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable \"Sticky ATC\"",
      "info": "Quickly enable or disable this feature",
      "default": true
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title Size",
      "default": "h4",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ]
    },
    { "type": "checkbox", "id": "show_img", "default": true, "label": "Show image" },
    { "type": "text", "id": "img_width", "default": "80", "label": "Image width (px)" },
    { "type": "text", "id": "img_height", "default": "80", "label": "Image height (px)" },
    { "type": "checkbox", "id": "show_quantity_input", "default": true, "label": "Show quantity field" },
    { "type": "checkbox", "id": "show_title", "default": true, "label": "Show Title" },
    { "type": "checkbox", "id": "show_price", "default": true, "label": "Show Price" },
    {
      "type": "select",
      "id": "btn_style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary",
      "label": "'Add to cart' button style"
    },
    { "type": "header", "content": "Advanced" },
    {
      "type": "range",
      "id": "offset",
      "label": "Offset",
      "min": 0,
      "max": 500,
      "step": 10,
      "default": 0,
      "info": "Adjust the offset value when showing the Sticky ATC section related to the main product form."
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Padding top", "min": 0, "max": 5, "step": 0.5, "default": 0.5 },
    { "type": "range", "id": "pb", "label": "Padding bottom", "min": 0, "max": 5, "step": 0.5, "default": 0.5 }
  ]
}
{% endschema %}
