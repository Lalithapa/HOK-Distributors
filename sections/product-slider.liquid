{%- style -%}
    .section-{{ section.id }}-margin  {
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }

    @media screen and (max-width: 768px) {
      .section-{{ section.id }}-margin  {
        margin-top: {{ section.settings.margin_top_mobile }}px;
        margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      }
    }
{%- endstyle -%}

<section class="section-{{ section.id }}-margin">
  <div class="{{ section.settings.container }} mx-auto {{ section.settings.section_bg }} rounded-xl"> 
    <div class="slider-container !py-[44px] {% if section.settings.container != 'page-width' %} page-width{% endif %}">
      <!-- Header -->
      <div class="flex items-center justify-between gap-4 pb-[24px]">
        <h2 class="text-xl font-semibold text-gray-900 lg:pl-[12px]">{{ section.settings.heading }}</h2>

        {%- if section.settings.collection.products != blank -%}
        <a href="{{ section.settings.collection.url }}"
          class="inline-flex items-center rounded-full border border-[#3C5865] px-[3rem] py-2 text-[14px] font-semibold tracking-wide text-gray-800 hover:bg-gray-100 transition">
          {{ "View All" }}
        </a>
        {%- endif -%}
      </div>
      <!-- Slider -->
      <div class="relative">
        <!-- Swiper -->
        <div class="swiper" id="swiper-{{ section.id }}">
          <div class="swiper-wrapper lg:px-[12px] pb-[24px]">
          {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
            <div class="swiper-slide !h-auto">
              <!-- Slide inner: your product card goes here -->
              {% render 'product-pocket' ,
                  card_product: product,
                  lazy_load: true,
                  section_id: section.id 
                %}
            </div>
            {%- endfor -%}
          </div>

          {%- if section.settings.scrollbar -%}
            <div class="swiper-scrollbar !relative"></div>
          {%- endif -%}
        </div>

        {%- if section.settings.navigation -%}
        <button class="swiper-button-prev !left-0 lg:-left-4 after:!text-base after:!font-bold" aria-label="Previous"></button>
        <button class="swiper-button-next !right-0 lg:-right-4 after:!text-base after:!font-bold" aria-label="Next"></button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<script>
  (function() {
    const swiperEl = document.querySelector('#swiper-{{ section.id }}');
    if (!swiperEl) return;
    /* eslint-disable no-new */
    new Swiper(swiperEl, {
      slidesPerView: 1.4,
      spaceBetween: 12,
      grabCursor: true,
      loop: {{ section.settings.loop | json }},
      navigation: {
        nextEl: swiperEl.parentElement.querySelector('.swiper-button-next'),
        prevEl: swiperEl.parentElement.querySelector('.swiper-button-prev'),
      },
      scrollbar: {
        el:  swiperEl.parentElement.querySelector('.swiper-scrollbar')
      },
      breakpoints: {
        564: { slidesPerView: 1.5, spaceBetween: 12 },
        768: { slidesPerView: 2.5, spaceBetween: 20 },
        1024:{ slidesPerView: 3.5, spaceBetween: 24 },
        1400:{ slidesPerView: 3.8, spaceBetween: 32 }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product slider",
  "settings": [
    {
        "type": "select",
        "id": "container",
        "label": "Container width",
        "default": "page-width",
        "options": [
        { "value": "page-width", "label": "Theme Default" },
        { "value": "w-full lg:w-[calc(100%-40px)]", "label": "Full width (100%-40px)" }
        ]
    },
    {
    "type": "header",
    "content": "Desktop Margin"
    },
  {
    "type": "range",
    "id": "margin_top_desktop",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Top",
    "default": 36
  },

  {
    "type": "range",
    "id": "margin_bottom_desktop",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Bottom",
    "default": 36
  },
   {
    "type": "header",
    "content": "Mobile Margin"
  },
  {
    "type": "range",
    "id": "margin_top_mobile",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Top",
    "default": 36
  },
  {
    "type": "range",
    "id": "margin_bottom_mobile",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Bottom",
    "default": 36
  },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New items" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose Collection"
    },
     {
      "type": "range",
      "id": "products_to_show",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 6,
      "label": "Number of products to show"
    },

    {
      "type": "select",
      "id": "section_bg",
      "label": "Section background",
      "default": "bg-white",
      "options": [
        { "value": "bg-white", "label": "White" },
        { "value": "bg-[#F1F0F0]", "label": "Gray 50" },
        { "value": "bg-transparent", "label": "Transparent" }
      ]
    },
    { "type": "checkbox", "id": "navigation", "label": "Show navigation arrows", "default": true },
    { "type": "checkbox", "id": "scrollbar", "label": "Show scrollbar", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Enable loop", "default": false }
  ],
  "presets": [
    {
      "name": "Product slider",
      "category": "Product slider"
    }
  ]
}
{% endschema %}
