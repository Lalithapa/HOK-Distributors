<!-- section/single_banner.liquid -->
{%- style -%}
    .section-{{ section.id }}-margin  {
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      background-color: {{ section.settings.background_color }};
    }

    @media screen and (max-width: 768px) {
      .section-{{ section.id }}-margin  {
        margin-top: {{ section.settings.margin_top_mobile }}px;
        margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
    }

{%- endstyle -%}
<div class="section-{{ section.id }}-margin">
  <div class="{{ section.settings.container }} mx-auto scroll-trigger animate--fade-in">
    {% if template == page.community or section.settings.heading_text != blank %}
      <p class="top_heading_banner">{{ section.settings.heading_text }}</p>
    {% endif %} 
    {% if customer %}
        <a href="{% if section.settings.after_link == '#' %}javascript:void(0){% else %}{{ section.settings.after_link }}{% endif %}">
      <img
        class="desktop_screen rounded-2xl"
        id="top-banner"
        src="{{ section.settings.after_image | image_url }}"
        alt="{{ section.settings.after_image.alt | escape }}"
        width="100%"
        height="100%"
        loading="eager"
      >
      <img
        class="mobile_screen rounded-2xl"
        src="{{ section.settings.after_image_mobile | image_url }}"
        alt="{{ section.settings.after_image_mobile.alt | escape }}"
        width="100%"
        height="100%"
        loading="eager"
      >
    </a>
        {% else %}
        <a href="{% if section.settings.before_link == '#' %}javascript:void(0){% else %}{{ section.settings.before_link }}{% endif %}">
      <img
        class="desktop_screen rounded-2xl"
        src="{{ section.settings.before_image | image_url }}"
        alt="{{ section.settings.before_image.alt | escape }}"
        width="100%"
        height="100%"
        loading="eager"
      >
      <img
        class="mobile_screen rounded-2xl"
        src="{{ section.settings.before_image_mobile | image_url }}"
        alt="{{ section.settings.before_image_mobile.alt | escape }}"
        width="100%"
        height="100%"
        loading="eager"
      >
    </a>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Before After Login Banner",
  "class": "single-banner", 
  "settings": [
    {
        "type": "select",
        "id": "container",
        "label": "Container width",
        "default": "page-width",
        "options": [
        { "value": "page-width", "label": "Theme Default" },
        { "value": "w-[calc(100%-32px)] lg:w-[calc(100%-40px)]", "label": "100%-40px Desktop and 100%-32px Mobile" }
        ]
    },
    {
    "type": "header",
    "content": "Desktop Margin"
    },
  {
    "type": "range",
    "id": "margin_top_desktop",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Top",
    "default": 36
  },

  {
    "type": "range",
    "id": "margin_bottom_desktop",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Bottom",
    "default": 36
  },
    {
    "type": "range",
    "id": "padding_top_desktop",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Padding Top",
    "default": 0
  },

  {
    "type": "range",
    "id": "padding_bottom_desktop",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Padding Bottom",
    "default": 0
  },
  {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
  {
    "type": "header",
    "content": "Mobile Margin"
  },
  {
    "type": "range",
    "id": "margin_top_mobile",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Top",
    "default": 36
  },
  {
    "type": "range",
    "id": "margin_bottom_mobile",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "Margin Bottom",
    "default": 36
  },
    {
    "type": "range",
    "id": "padding_top_mobile",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "padding Top",
    "default": 0
  },
  {
    "type": "range",
    "id": "padding_bottom_mobile",
    "min": 0,
    "max": 200,
    "step": 2,
    "unit": "px",
    "label": "padding Bottom",
    "default": 0
  },
    {
    "type": "text",
    "id": "heading_text",
    "label": "Heading"
  },
    {
    "type": "header",
    "content": "Before Login Banner Details"
    },
  {
    "type": "url",
    "id": "before_link",
    "label": "banner Link"
  },
    {
    "type": "image_picker",
    "id": "before_image",
    "label": "Image"
    },
    {
    "type": "image_picker",
    "id": "before_image_mobile",
    "label": "Mobile Image"
    },
   {
    "type": "header",
    "content": "After Login Banner Details"
    },
  {
    "type": "url",
    "id": "after_link",
    "label": "banner Link"
  },
    {
        "type": "image_picker",
        "id": "after_image",
        "label": "Image"
      },
    {
        "type": "image_picker",
        "id": "after_image_mobile",
        "label": "Mobile Image"
      }
  ],
   "presets": [
  {
    "name": "Before After Login Banner"
  }
]
}
{% endschema %}
<script>
  document.getElementById("top-banner").addEventListener("click", function() {
    document.getElementById("main-footer").scrollIntoView({
      behavior: "smooth"
    });
  });
</script>