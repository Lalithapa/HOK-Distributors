<section id="brand-partners-{{ section.id }}" class="max-w-[95%] bg-white"
  style="padding-top: {{ section.settings.pt }}px; padding-bottom: {{ section.settings.pb }}px;">
  <div class="w-full lg:w-[90%] mx-auto px-4">
    {% if section.settings.heading != blank %}
      <h2 class="!text-[#2A2F38] !text-[28px] lg:!text-[36px] not-italic font-bold leading-normal tracking-[-1.8px] py-0 px-[15px] lg:py-0 lg:px-0 ">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <div class="mt-[16px]  !text-[#717171]  !text-[18px] not-italic font-medium leading-normal mb-[24px] py-0 px-[15px] lg:py-0 lg:px-0">
        {{ section.settings.subtext }}
      </div>  
    {% endif %}
    <div class="mt-8 lg:mt-10 !grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 xl:grid-cols-5 lg:gap-x-[25px] gap-y-[20px] justify-center items-center lg:max-w-[85%] m-auto xl:mt-[40px]">
      {% for block in section.blocks %}
        {% if block.type == 'logo' %}
          <div class="rounded-[20px] w-[138px] h-[124px] xl:w-[180px] xl:h-[170px] 2xl:w-[212px] 2xl:h-[190px] flex items-center justify-center shadow-[inset_9px_7px_15px_-4px_#E6E6E6]  bg-[#fff]  p-5 md:p-7 transition-transform duration-200 group-hover:-translate-y-0.5 m-auto">    
                {% if block.settings.logo != blank %}
                  <div  class="w-[90px] h-auto lg:w-[124px] lg:h-[65px] md:h-[58px] rounded-[10px] px-[5px] py-0" style="background-color: {{ block.settings.badge_bg }};">
                  <img
                    src="{{ block.settings.logo | image_url: width: 124 }}"
                    alt="{{ block.settings.alt | escape }}"
                    class="w-[88px] h-auto lg:w-[124px] lg:h-[65px] object-contain {% if section.settings.grayscale %}grayscale group-hover:grayscale-0 transition{% endif %}"
                    loading="lazy"
                    width="100%"
                    height="auto" 
                    >
                    </div>
                {% else %}
                  <span class="text-xs text-gray-400">Upload logo</span>
                {% endif %} 
            </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Brand partners grid",
  "class": "section-brand-partners",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Brand Partners" },
    { "type": "text", "id": "subtext", "label": "Sub text", "default": "<p>HOK Distributors was founded with one goal — to bridge the gap between premium beauty brands and retailers across India and to make distribution simple, transparent, and rewarding for retailers.</p>" },
    { "type": "checkbox", "id": "grayscale", "label": "Show logos in grayscale (hover to reveal color)", "default": false },
    { "type": "range", "id": "pt", "label": "Padding top (px)", "min": 0, "max": 160, "step": 4, "default": 40 },
    { "type": "range", "id": "pb", "label": "Padding bottom (px)", "min": 0, "max": 160, "step": 4, "default": 40 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo card",
      "limit": 30,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Brand logo" },
        { "type": "color", "id": "badge_bg", "label": "Inner badge background", "default": "#EAF3FF" },
        { "type": "url", "id": "link", "label": "Optional link" },
        { "type": "checkbox", "id": "new_tab", "label": "Open link in new tab", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand partners grid",
      "category": "Logos",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Focallure", "badge_bg": "#EDEAFF" } },
        { "type": "logo", "settings": { "alt": "Koric", "badge_bg": "#DFF6E5" } },
        { "type": "logo", "settings": { "alt": "Milani", "badge_bg": "#FDE2E1" } },
        { "type": "logo", "settings": { "alt": "Wet n Wild", "badge_bg": "#DDEEFF" } },
        { "type": "logo", "settings": { "alt": "Dr. PAWPAW", "badge_bg": "#EEF9D6" } },
        { "type": "logo", "settings": { "alt": "Focallure", "badge_bg": "#EFEFEF" } },
        { "type": "logo", "settings": { "alt": "Koric", "badge_bg": "#FFF0BD" } },
        { "type": "logo", "settings": { "alt": "Milani", "badge_bg": "#DDEBFF" } },
        { "type": "logo", "settings": { "alt": "Dr. PAWPAW", "badge_bg": "#EAFAD2" } },
        { "type": "logo", "settings": { "alt": "Focallure", "badge_bg": "#EEE6FF" } }
      ]
    }
  ]
}
{% endschema %}