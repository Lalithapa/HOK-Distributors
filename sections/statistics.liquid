<!-- Stats strip -->
<section class="{{ section.settings.container }} relative bg-white  
  {% if section.settings.show_after_login %}
    {% unless customer %}hidden{% endunless %}
  {% else %}
    {% if customer %}hidden{% endif %}
  {% endif %}">
<div class="mx-auto">
    <div class="relative rounded-2xl border border-gray-200 bg-[#F5F5F5] shadow-sm">
      <div class="grid gap-8 px-6 !py-[35px] sm:grid-cols-2 lg:grid-cols-4 lg:gap-6 justify-evenly">
        <!-- Item 1 -->
        <div class="flex items-center gap-4 lg:justify-center">
          <div>
            <div class="font-extrabold text-gray-900 sm:text-4xl md:text-[60px] leading-none">200+</div>
            <p class="text-[14px] text-[#2A2F38] leading-normal">trusted clients since 2017</p>
          </div>
        </div>

        <!-- Item 2 (with icon) -->
        <div class="flex flex-col items-center gap-4 lg:justify-center">
          <!-- Fingerprint icon -->
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="53" height="51" viewBox="0 0 53 51" fill="none">
                <rect x="0.841797" width="52" height="51" fill="url(#pattern0_6_2430)"/>
                <defs>
                <pattern id="pattern0_6_2430" patternContentUnits="objectBoundingBox" width="1" height="1">
                <use xlink:href="#image0_6_2430" transform="matrix(0.00158696 0 0 0.0016269 0.0937377 0.0835131)"/>
                </pattern>
                <image id="image0_6_2430" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
                </defs>
            </svg>
          <div>
             <p class="text-[14px] text-[#2A2F38] leading-normal">Guaranteed 100% <br> Authentic Products</p>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="flex items-center gap-4 lg:justify-center">
          <div>
           <div class="font-extrabold text-gray-900 sm:text-4xl md:text-[60px] leading-none">2000+</div>
             <p class="text-[14px] text-[#2A2F38] leading-normal">SKU’s ready to ship to your store</p>
          </div>
        </div>

        <!-- Item 4 (with icon) -->
        <div class="flex flex-col items-center gap-4 lg:justify-center">
          <!-- Badge/Seal icon -->
        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="50" height="51" viewBox="0 0 50 51" fill="none">
            <rect x="0.341797" width="49" height="51" fill="url(#pattern0_6_2436)"/>
            <defs>
            <pattern id="pattern0_6_2436" patternContentUnits="objectBoundingBox" width="1" height="1">
            <use xlink:href="#image0_6_2436" transform="matrix(0.00320746 0 0 0.0030929 -0.481481 -0.446429)"/>
            </pattern>
            <image id="image0_6_2436" width="612" height="612" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
            </defs>
        </svg>
          <div>
             <p class="text-[14px] text-[#2A2F38] leading-normal">GST-Compliant <br> Billing &amp; Invoicing</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- End stats strip -->
 {% schema %}
{
  "name": "Stats strip",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Theme Default" },
        { "value": "w-[calc(100%-40px)]", "label": "Full width (100%-40px)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_after_login",
      "label": "Show Stats Strip After Login",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Stats strip"
    }
  ]
}
{% endschema %}
