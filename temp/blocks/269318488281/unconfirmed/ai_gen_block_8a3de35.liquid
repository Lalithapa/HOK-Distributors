{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-layout-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-magazine-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-magazine-hero-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
    min-height: 400px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-magazine-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  .ai-magazine-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    position: relative;
  }

  .ai-magazine-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-magazine-hero-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    padding: 40px 30px 30px;
    color: white;
    z-index: 2;
  }

  .ai-magazine-hero-category-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: {{ block.settings.accent_color }};
    margin-bottom: 8px;
  }

  .ai-magazine-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 12px;
    color: white;
  }

  .ai-magazine-hero-excerpt-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.5;
    opacity: 0.9;
    margin: 0 0 16px;
  }

  .ai-magazine-hero-meta-{{ ai_gen_id }} {
    font-size: 14px;
    opacity: 0.8;
  }

  .ai-magazine-sidebar-{{ ai_gen_id }} {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-magazine-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-magazine-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .ai-magazine-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 180px;
    position: relative;
    background-color: #f4f4f4;
  }

  .ai-magazine-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-magazine-card-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-magazine-card-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-magazine-card-category-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: {{ block.settings.accent_color }};
    margin-bottom: 8px;
  }

  .ai-magazine-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-card-excerpt-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0 0 12px;
  }

  .ai-magazine-card-meta-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-magazine-secondary-grid-{{ ai_gen_id }} {
    grid-column: span 12;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_gap }}px;
  }

  .ai-magazine-secondary-card-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 20px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .ai-magazine-secondary-card-{{ ai_gen_id }}:hover {
    transform: translateY(-1px);
  }

  .ai-magazine-secondary-image-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: {{ block.settings.border_radius | divided_by: 2 }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-magazine-secondary-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-secondary-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-magazine-secondary-placeholder-{{ ai_gen_id }} svg {
    width: 30px;
    height: 30px;
    opacity: 0.3;
  }

  .ai-magazine-secondary-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-magazine-secondary-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-secondary-meta-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-magazine-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 990px) {
    .ai-magazine-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-magazine-hero-{{ ai_gen_id }},
    .ai-magazine-sidebar-{{ ai_gen_id }} {
      grid-column: span 1;
    }

    .ai-magazine-secondary-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-magazine-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_title_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-magazine-hero-content-{{ ai_gen_id }} {
      padding: 30px 20px 20px;
    }

    .ai-magazine-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_title_size | times: 0.7 }}px;
    }

    .ai-magazine-secondary-card-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }

    .ai-magazine-secondary-image-{{ ai_gen_id }} {
      width: 100%;
      height: 120px;
    }
  }
{% endstyle %}

<div class="ai-magazine-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-magazine-grid-{{ ai_gen_id }}">
    <article class="ai-magazine-hero-{{ ai_gen_id }}">
      {% if block.settings.hero_image %}
        <img
          src="{{ block.settings.hero_image | image_url: width: 800 }}"
          alt="{{ block.settings.hero_image.alt | escape }}"
          class="ai-magazine-hero-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.hero_image.width }}"
          height="{{ block.settings.hero_image.height }}"
        >
      {% else %}
        <div class="ai-magazine-hero-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-magazine-empty-state-{{ ai_gen_id }}">
            Add a hero image
          </div>
        </div>
      {% endif %}

      <div class="ai-magazine-hero-content-{{ ai_gen_id }}">
        {% if block.settings.hero_category != blank %}
          <div class="ai-magazine-hero-category-{{ ai_gen_id }}">{{ block.settings.hero_category }}</div>
        {% endif %}
        {% if block.settings.hero_title != blank %}
          <h2 class="ai-magazine-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h2>
        {% endif %}
        {% if block.settings.hero_excerpt != blank %}
          <p class="ai-magazine-hero-excerpt-{{ ai_gen_id }}">{{ block.settings.hero_excerpt }}</p>
        {% endif %}
        {% if block.settings.hero_author != blank or block.settings.hero_date != blank %}
          <div class="ai-magazine-hero-meta-{{ ai_gen_id }}">
            {% if block.settings.hero_author != blank %}By {{ block.settings.hero_author }}{% endif %}
            {% if block.settings.hero_author != blank and block.settings.hero_date != blank %} • {% endif %}
            {% if block.settings.hero_date != blank %}{{ block.settings.hero_date }}{% endif %}
          </div>
        {% endif %}
      </div>
    </article>

    <aside class="ai-magazine-sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'sidebar_image_' | append: i
          assign category_key = 'sidebar_category_' | append: i
          assign title_key = 'sidebar_title_' | append: i
          assign excerpt_key = 'sidebar_excerpt_' | append: i
          assign author_key = 'sidebar_author_' | append: i
          assign date_key = 'sidebar_date_' | append: i

          assign image = block.settings[image_key]
          assign category = block.settings[category_key]
          assign title = block.settings[title_key]
          assign excerpt = block.settings[excerpt_key]
          assign author = block.settings[author_key]
          assign date = block.settings[date_key]
        %}

        <article class="ai-magazine-card-{{ ai_gen_id }}">
          <div class="ai-magazine-card-image-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 400 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-magazine-card-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-magazine-card-content-{{ ai_gen_id }}">
            {% if category != blank %}
              <div class="ai-magazine-card-category-{{ ai_gen_id }}">{{ category }}</div>
            {% endif %}
            {% if title != blank %}
              <h3 class="ai-magazine-card-title-{{ ai_gen_id }}">{{ title }}</h3>
            {% endif %}
            {% if excerpt != blank %}
              <p class="ai-magazine-card-excerpt-{{ ai_gen_id }}">{{ excerpt }}</p>
            {% endif %}
            {% if author != blank or date != blank %}
              <div class="ai-magazine-card-meta-{{ ai_gen_id }}">
                {% if author != blank %}By {{ author }}{% endif %}
                {% if author != blank and date != blank %} • {% endif %}
                {% if date != blank %}{{ date }}{% endif %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </aside>

    <section class="ai-magazine-secondary-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'secondary_image_' | append: i
          assign title_key = 'secondary_title_' | append: i
          assign author_key = 'secondary_author_' | append: i
          assign date_key = 'secondary_date_' | append: i

          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
          assign author = block.settings[author_key]
          assign date = block.settings[date_key]
        %}

        <article class="ai-magazine-secondary-card-{{ ai_gen_id }}">
          <div class="ai-magazine-secondary-image-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 160 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-magazine-secondary-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-magazine-secondary-content-{{ ai_gen_id }}">
            {% if title != blank %}
              <h4 class="ai-magazine-secondary-title-{{ ai_gen_id }}">{{ title }}</h4>
            {% endif %}
            {% if author != blank or date != blank %}
              <div class="ai-magazine-secondary-meta-{{ ai_gen_id }}">
                {% if author != blank %}By {{ author }}{% endif %}
                {% if author != blank and date != blank %} • {% endif %}
                {% if date != blank %}{{ date }}{% endif %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </section>
  </div>
</div>

